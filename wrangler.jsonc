{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "support-triage-agent",
  "main": "src/server.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI", "remote": true },
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*", "/oauth/*", "/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "class_name": "TriageAgent",
        "name": "TriageAgent"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["TriageAgent"],
      "tag": "v1"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "support-triage-agent-db",
      "database_id": "7dc2f60f-495b-45a3-b576-6b010259bc19"
    }
  ],
  "vectorize": [
    {
      "binding": "KB_INDEX",
      "index_name": "support-triage-kb",
      "remote": true
    }
  ],
  "vars": {
    "ESCALATION_WINDOW_SECONDS": "120"
  }
}
